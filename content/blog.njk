---
layout: 'layouts/home.njk'
title: Blog | henry is online
eleventyNavigation:
  key: Blog
  order: 2
---
<h1 id="">Blog Posts</h1>

<ul class="postlist">
{# Display the year in the blog archive #}
{# modified from https://chriskirknielsen.com/blog/group-posts-by-year-with-nunjucks-in-eleventy/ #}
{% set currentYear = '' %}
{% for post in collections.post | reverse %}
	{% set postYear = post.date | yearString %}
	{% if currentYear != postYear %}
	<h2>{{ postYear }}</h2>
	{% endif %}
	<li>
		<p>
			<time datetime="{{ post.date | htmlDateString }}">{{ post.date | monthDay }}</time> — 
			<a href="{{ post.url }}">{{ post.data.title }}</a>
		</p>
	</li>
	{% set currentYear = postYear %}
{% endfor %}
</ul>